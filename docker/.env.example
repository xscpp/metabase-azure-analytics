# Copy this file to .env and fill in real values. NEVER commit the real .env file to git.

# Metabase's internal application database
MB_DB_NAME=metabase
MB_DB_USER=metabase_admin
MB_DB_PASS=CHANGE_ME_TO_A_STRONG_PASSWORD

# Optional: set once you know the public URL/IP, e.g. http://20.10.30.40:3000
MB_SITE_URL=

# Timezone used by Metabase for scheduled reports
TIMEZONE=Asia/Riyadh

# Where persistent data (Postgres + plugins) is stored on the host.
# On the Azure VM this should point to the mounted data disk, e.g. /data
DATA_PATH=./data
